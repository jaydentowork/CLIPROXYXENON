{
  "name": "xeneon-edge-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent CLIProxyAPI monitoring for the CORSAIR XENEON EDGE",
  "engines": { "node": ">=24.2.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node src/server.js --demo",
    "test": "node --test",
    "probe": "node --env-file-if-exists=.env scripts/probe-management.js"
  }
}
