# Copy this only if you do not already have .env. Never commit real credentials.
CLIPROXYAPI_BASE_URL=https://proxy.example.com
MANAGEMENT_KEY=replace-with-plaintext-management-key

# Direct TCP/TLS RESP listener, separate from the management HTTP address.
# redis:// for a trusted local connection; rediss:// for TLS.
CLIPROXYAPI_RESP_URL=redis://127.0.0.1:8317
# Omit to use MANAGEMENT_KEY. This listener must support AUTH and SUBSCRIBE usage.
CLIPROXYAPI_RESP_PASSWORD=

# Map exact Codex auth_index values, never array positions or generic plan names.
CODEX_ACCOUNT_WEIGHTS={}
DATA_PATH=./data/dashboard.sqlite
HOST=127.0.0.1
PORT=8787
